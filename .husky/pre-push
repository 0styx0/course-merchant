#!/usr/bin/env sh

# Same Prettier check as CI; lint-staged only formats some file types
yarn --cwd api format:check
yarn --cwd web format:check

# The tests of the shell scripts that check the repo's layout and design docs and measure its usage
bash .husky/check-folder-file-count.test.sh
bash .claude/skills/usage-review/measure.test.sh
bash .claude/hooks/lint-design-doc.test.sh

# Unused files, exports and dependencies (whole-project, so not on commit)
yarn --cwd api knip
yarn --cwd web knip

# The commit hook only runs the unit tests related to what it staged
yarn --cwd api test:unit
yarn --cwd web test:unit

yarn --cwd api test:integration
yarn --cwd web test:browser

yarn --cwd api test:e2e