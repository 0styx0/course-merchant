{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "admin:set-password": "node dist/src/auth/cli/set-admin-password.js",
    "knip": "knip",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test:cov": "vitest run --coverage",
    "db:test:up": "docker compose -f docker-compose.test.yaml up -d --wait",
    "db:dev:migrate": "dotenv run --override --file .env -- yarn prisma db migrate --advance-ref db",
    "db:test:migrate": "dotenv run --override --file .env.test -- yarn prisma db migrate --advance-ref db",
    "generate:api-types": "openapi-typescript ./openapi/openapi-v1.yaml -o ./src/generated/api.d.ts",
    "contract:emit": "prisma contract emit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "yarn test:unit --watch",
    "test:unit:related": "vitest related --run --passWithNoTests --config vitest.unit.config.ts",
    "test:integration": "yarn db:test:up && yarn db:test:migrate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "yarn db:test:up && yarn db:test:migrate && vitest run --config vitest.e2e.config.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/password": "^5.2.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/orm-postgres": "8.0.0-rc.19",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3",
    "multer": "2.5.0",
    "nodemailer": "^10.2.1",
    "prisma": "8.0.0-rc.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/cli-engine": "0.9.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "js-yaml": "^4.1.0",
    "knip": "6.41.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
