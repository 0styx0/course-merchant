// use prisma-8
// add a value when a provider is integrated. payments record which provider
// took them, so refunds and webhooks route to it even after a migration
enum PaymentProvider {
  STRIPE = "stripe"
}

enum PaymentStatus {
  PENDING = "pending"
  SUCCEEDED = "succeeded"
  EXPIRED = "expired"
  REFUNDED = "refunded"
}

enum EmailKind {
  ACCESS_GRANTED = "access_granted"
  ALREADY_OWNED = "already_owned"
  ACCESS_SUSPENDED = "access_suspended"
  DISPUTE_ALERT = "dispute_alert"
}

enum EmailStatus {
  PENDING = "pending"
  SENT = "sent"
  FAILED = "failed"
}

enum CourseStatusName {
  DRAFTED = "drafted"
  PUBLISHED = "published"
  ARCHIVED = "archived"
  DELETED = "deleted"
}

model Course {
  id          Uuid                       @id @onCreate(uuid())
  title       String
  summary     String
  description String
  contentUrl  String

  startsAt    DateTime
  endsAt      DateTime
  timeZone    String

  createdAt   DateTime                   @default(now())
  updatedAt   temporal.updatedAtJsDate()

  statuses    CourseStatus[]
  prices      CoursePrice[]
  enrollments Enrollment[]
  image       CourseImage?

  @@index([startsAt])
}

// a course's one image, already converted to a 1600x900 WebP. Never deleted.
// Course queries select only updatedAt: only the image endpoints read bytes
model CourseImage {
  courseId  Uuid     @id
  bytes     Bytes
  // set by the repository on every save. Its epoch milliseconds are the
  // image's version in URLs and responses
  updatedAt DateTime

  course    Course   @relation(fields:[courseId], references:[id], onDelete: Restrict)
}

model CourseStatus {
  id        Uuid             @id @onCreate(uuid())
  courseId  Uuid
  name      CourseStatusName

  changedAt DateTime         @default(now())

  course    Course           @relation(fields:[courseId], references:[id])

  @@unique([courseId, changedAt])
}

model CoursePrice {
  id          Uuid      @id @onCreate(uuid())
  courseId    Uuid

  amount      Int
  currency    String

  effectiveAt DateTime
  createdAt   DateTime  @default(now())

  course      Course    @relation(fields:[courseId], references:[id])
  payments    Payment[]

  @@unique([courseId, effectiveAt])
}

model Customer {
  id                Uuid                       @id @onCreate(uuid())
  name              String
  email             String                     @unique

  createdAt         DateTime                   @default(now())
  updatedAt         temporal.updatedAtJsDate()

  payments          Payment[]
  enrollments       Enrollment[]
}

// one checkout attempt. amount and currency are copied from the price when
// checkout starts, so later price edits never change what was charged
model Payment {
  id                 Uuid            @id @onCreate(uuid())

  customerId         Uuid
  coursePriceId      Uuid

  provider           PaymentProvider
  status             PaymentStatus

  amount             Int
  currency           String

  // set once the provider has created the checkout / taken the payment
  providerCheckoutId String?
  providerPaymentId  String?

  createdAt          DateTime        @default(now())
  paidAt             DateTime?
  refundedAt         DateTime?

  customer           Customer        @relation(fields:[customerId], references:[id])
  coursePrice        CoursePrice     @relation(fields:[coursePriceId], references:[id])

  enrollment         Enrollment?

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@index([customerId])
  @@index([coursePriceId])
  @@index([status, createdAt])
}

// gives access only while revokedAt and suspendedAt are both null.
// a repurchase after a refund reactivates the same row
model Enrollment {
  id          Uuid      @id @onCreate(uuid())
  courseId    Uuid
  customerId  Uuid
  // null for free courses
  paymentId   Uuid?     @unique

  purchasedAt DateTime  @default(now())
  // set by a full refund
  revokedAt   DateTime?
  // set by a dispute. cleared by hand by the owner
  suspendedAt DateTime?

  course      Course    @relation(fields:[courseId], references:[id])
  customer    Customer  @relation(fields:[customerId], references:[id])
  payment     Payment?  @relation(fields:[paymentId], references:[id])
  emails      EnrollmentEmail[]

  @@unique([courseId, customerId])
  @@index([customerId])
}

model ProcessedPaymentEvent {
  provider    PaymentProvider
  eventId     String
  type        String
  processedAt DateTime        @default(now())

  @@id([provider, eventId])
}

// written in the same transaction as the change that triggers the email,
// so an email is never lost. It can rarely be sent twice; see the outbox
// decisions in docs/payments.md
model EmailOutbox {
  id            Uuid        @id @onCreate(uuid())
  kind          EmailKind
  recipient     String
  payload       Json

  status        EmailStatus @default(PENDING)
  attempts      Int
  nextAttemptAt DateTime    @default(now())
  lastError     String?

  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  enrollmentLink EnrollmentEmail?

  @@index([status, nextAttemptAt])
  @@index([recipient, createdAt])
}

// links an email to the enrollment it's about, so the admin view can find an
// enrollment's emails. Owner alerts (dispute_alert) have no enrollment
model EnrollmentEmail {
  emailId      Uuid        @id
  enrollmentId Uuid

  email        EmailOutbox @relation(fields:[emailId], references:[id])
  enrollment   Enrollment  @relation(fields:[enrollmentId], references:[id])

  @@index([enrollmentId])
}

// the owner's login. Created and updated only by the set-password command
model Admin {
  id           Uuid                       @id @onCreate(uuid())
  // trimmed and lowercased before it's stored or looked up
  email        String                     @unique
  // an Argon2id hash in the standard `$argon2id$...` string form
  passwordHash String

  createdAt    DateTime                   @default(now())
  updatedAt    temporal.updatedAtJsDate()

  sessions     AdminSession[]
}

// one login. Only the SHA-256 hash of the token is stored. updatedAt is the
// last time the session was used (refreshed at most every 5 minutes); a
// session ends 7 days after createdAt or 24 hours after updatedAt
model AdminSession {
  id        Uuid                       @id @onCreate(uuid())
  adminId   Uuid
  tokenHash String                     @unique

  createdAt DateTime                   @default(now())
  updatedAt temporal.updatedAt()

  admin     Admin                      @relation(fields:[adminId], references:[id])

  @@index([adminId])
}

// one login try, kept to limit tries per email. Not linked to Admin: tries
// for unknown emails are counted too
model AdminLoginAttempt {
  id        Uuid     @id @onCreate(uuid())
  // trimmed and lowercased, like Admin.email
  email     String

  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
