// use prisma-8

enum PaymentProvider {
  STRIPE = "stripe"
  PAYPAL = "paypal"
  SQUARE = "square"
}

enum PaymentStatus {
  PENDING = "pending"
  SUCCEEDED = "succeeded"
  FAILED = "failed"
  REFUNDED = "refunded"
}

model Course {
  id          Uuid   @id @default(uuid())
  title       String
  description String
  contentUrl  String

  startsAt  DateTime
  endsAt    DateTime
  timeZone  String

  archivedAt DateTime?

  createdAt DateTime                 @default(now())
  updatedAt temporal.updatedAtJsDate()

  prices      CoursePrice[]
  enrollments Enrollment[]

  @@index([startsAt])
}

model CoursePrice {
  id       Uuid @id @default(uuid())
  courseId Uuid

  amount   Int
  currency String

  effectiveAt DateTime
  createdAt   DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id])
  payments Payment[]

  @@unique([courseId, effectiveAt])
  @@index([courseId, effectiveAt])
}

model Customer {
  id    Uuid   @id @default(uuid())
  email String @unique

  createdAt DateTime                 @default(now())
  updatedAt temporal.updatedAtJsDate()

  providerCustomers PaymentProviderCustomer[]
  payments          Payment[]
  enrollments       Enrollment[]
}

model PaymentProviderCustomer {
  id Uuid @id @default(uuid())

  customerId Uuid
  provider   PaymentProvider

  providerCustomerId String

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@unique([provider, providerCustomerId])
  @@unique([customerId, provider])
  @@index([customerId])
}

model Payment {
  id Uuid @id @default(uuid())

  customerId    Uuid
  coursePriceId Uuid

  provider PaymentProvider
  status   PaymentStatus

  amount   Int
  currency String

  providerPaymentId  String
  providerCheckoutId String?

  providerCustomerId Uuid?

  createdAt DateTime
  paidAt    DateTime?

  customer         Customer                 @relation(fields: [customerId], references: [id])
  coursePrice      CoursePrice              @relation(fields: [coursePriceId], references: [id])
  providerCustomer PaymentProviderCustomer? @relation(fields: [providerCustomerId], references: [id])

  enrollment Enrollment?

  @@unique([provider, providerPaymentId])
  @@index([customerId])
  @@index([coursePriceId])
  @@index([providerCustomerId])
}

model Enrollment {
  id         Uuid @id @default(uuid())
  courseId   Uuid
  customerId Uuid
  paymentId  Uuid @unique

  purchasedAt DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@unique([courseId, customerId])
  @@index([customerId])
}

model ProcessedPaymentEvent {
  provider    PaymentProvider
  eventId     String
  type        String
  processedAt DateTime @default(now())

  @@id([provider, eventId])
}