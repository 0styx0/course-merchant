# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Comma-separated ISO 4217 codes new course prices may use. Set it to the
# Stripe account's payout currency: any other currency adds a conversion fee
# to every sale. Defaults to USD.
# ALLOWED_CURRENCIES="USD"

# Stripe secret key. Prefer a restricted key (rk_test_ / rk_live_) that can
# only create and read Checkout Sessions and create refunds.
STRIPE_SECRET_KEY="rk_test_..."

# The public site buyers return to after paying, without a trailing slash.
WEB_BASE_URL="http://localhost:3001"
