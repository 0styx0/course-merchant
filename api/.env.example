# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# A database on another machine needs ?sslmode=require (or verify-full, the
# strictest); the API refuses to start otherwise. localhost is exempt.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Comma-separated ISO 4217 codes new course prices may use. Set it to the
# Stripe account's payout currency: any other currency adds a conversion fee
# to every sale. Defaults to USD.
# ALLOWED_CURRENCIES="USD"

# Stripe secret key. Prefer a restricted key (rk_test_ / rk_live_) that can
# only create and read Checkout Sessions and create refunds.
STRIPE_SECRET_KEY="rk_test_..."

# Signing secret for the webhook endpoint (/v1/webhooks/stripe). In the
# Stripe Dashboard it's shown on the endpoint's page; locally, `stripe listen`
# prints one when it starts.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Port the API listens on. Defaults to 3000; locally it's 3001 so it doesn't
# clash with the web app's dev server, which runs on 3000.
PORT=3001

# The public site buyers return to after paying, without a trailing slash.
WEB_BASE_URL="http://localhost:3000"

# Outgoing email over SMTP. Any provider works (Brevo, Resend, SES, Postmark,
# ...): paste its SMTP connection URL. Locally, Mailpit listens on
# smtp://localhost:1025.
# A server on another machine must support encryption (smtps://, or smtp://
# with STARTTLS); sending is refused otherwise. localhost is exempt.
SMTP_URL="smtps://user:password@smtp.example.com"
# The sender buyers see. The domain needs SPF and DKIM records set up with the
# provider, or mail lands in spam.
EMAIL_FROM="Course Shop <hello@example.com>"
EMAIL_SHOP_NAME="Course Shop"
