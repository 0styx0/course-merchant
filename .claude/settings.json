{
  "includeCoAuthoredBy": false,
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(yarn -s lint)",
      "Bash(yarn -s lint *)",
      "Bash(yarn lint *)",
      "Bash(yarn -s tsc *)",
      "Bash(yarn tsc *)",
      "Bash(yarn -s test)",
      "Bash(yarn -s test:unit)",
      "Bash(yarn -s test:integration *)",
      "Bash(yarn -s test:e2e *)",
      "Bash(yarn test:unit)",
      "Bash(yarn test:integration)",
      "Bash(yarn test:e2e)",
      "Bash(yarn -s vitest run *)",
      "Bash(yarn vitest *)",
      "Bash(yarn -s prettier --write *)",
      "Bash(yarn -s format:check)",
      "Bash(yarn -s db:test:up)",
      "Bash(yarn -s db:test:migrate)",
      "Bash(yarn -s generate:api-types)",
      "Bash(yarn -s --cwd ../web generate:api-types)",
      "Bash(yarn -s build)",
      "Bash(yarn contract:emit)",
      "Bash(yarn prisma *)",
      "Bash(yarn next typegen)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git blame *)",
      "Bash(git mv *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated-edits.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
